model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Source_files\File_load

	annotation PBI_QueryGroupOrder = 0

queryGroup Source_files

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CsvTables","DimDate","DimProduct","FactSales"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table DimProduct
ref table FactSales

ref cultureInfo en-US

