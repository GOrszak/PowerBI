model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Source_files\File_load

	annotation PBI_QueryGroupOrder = 0

queryGroup Source_files

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CsvTables","DimProduct","FactSales","BridgeCustomerInterest","BridgeProductInterest","CurrencySelector","DataDictionary_Columns","DataDictionary_Tables","DimAccount","DimCurrency","DimCustomer","DimEmployee","DimGeography","DimInterest","DimProductCategory","DimProductSubcategory","DimSegmentBands","DimStore","FactBudget","FactCustomerSatisfaction","FactExchangeRate","FactFinanceLedger","FactInventorySnapshot","FactReturns","FactWebSession","MetricSelector","WhatIfDiscount","WhatIfTopN","DimDate"]

annotation PBI_ProTooling = ["DevMode"]

